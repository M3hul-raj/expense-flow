# Copy to .env (gitignored) and replace placeholder values before running: docker compose up -d
# Keep POSTGRES_PASSWORD alphanumeric so it needs no URL-encoding inside the URI.
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_DB=expenseflow

# development enables HTTP cookies on http://127.0.0.1:5000;
# production requires HTTPS cookies and a 32+ char EXPENSEFLOW_SECRET_KEY.
EXPENSEFLOW_ENV=development
EXPENSEFLOW_SECRET_KEY=replace-with-32-plus-char-secret-key-for-prod

# Optional: point pytest at a separate test DB in Docker PostgreSQL (never your dev DB)
# EXPENSEFLOW_TEST_DATABASE_URI=postgresql+psycopg://expenseflow:replace-with-local-dev-password@127.0.0.1:5432/expenseflow_test
